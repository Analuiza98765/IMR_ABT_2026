"""
Exercicio 3 - Varredura Sensorial com Filtro de Alcance e Desvio de Ruido
---------------------------------------------------------------------------
Simula uma varredura com 7 feixes de distancia cobrindo um campo de
visao de 180 graus (-pi/2 a +pi/2), adiciona ruido gaussiano as
medicoes reais e aplica um filtro de limiar (threshold):
  - leituras < 10.0 px sao descartadas (erro de leitura)
  - leituras > 200.0 px sao cravadas em 200.0 px (alcance maximo)
Renderiza lado a lado, para cada feixe, o valor bruto (com ruido) e o
valor tratado pelo filtro.
"""

import math
import sys
import random
import pygame

LARGURA, ALTURA = 950, 650
FPS = 30

CENTRO = (LARGURA // 2, ALTURA - 120)
N_FEIXES = 7
FOV = math.pi  # 180 graus, de -pi/2 a +pi/2
ALCANCE_MAX = 200.0
LIMIAR_MIN = 10.0

BRANCO = (255, 255, 255)
PRETO = (20, 20, 20)
AZUL = (40, 110, 220)
VERMELHO = (220, 60, 60)
VERDE = (30, 160, 90)
CINZA = (170, 170, 170)
LARANJA = (230, 140, 30)

# Obstaculos simples no ambiente: lista de (x, y, raio) relativos ao centro
OBSTACULOS = [
    (-140, -260, 30),
    (0, -180, 22),
    (120, -300, 45),
    (170, -120, 18),
    (-60, -90, 12),
]


def distancia_real_do_feixe(angulo):
    """
    Calcula a distancia 'real' (sem ruido) ate o obstaculo mais proximo
    na direcao do angulo dado, a partir do centro do robo. Se nao atingir
    nenhum obstaculo, retorna o alcance maximo teorico do sensor (bem alto,
    para depois ser cravado pelo filtro).
    """
    passo = 2.0
    max_dist_busca = 400.0
    dist = 0.0
    while dist < max_dist_busca:
        px = CENTRO[0] + dist * math.sin(angulo)
        py = CENTRO[1] - dist * math.cos(angulo)
        for (ox, oy, orad) in OBSTACULOS:
            cx, cy = CENTRO[0] + ox, CENTRO[1] + oy
            if math.hypot(px - cx, py - cy) <= orad:
                return dist
        dist += passo
    return max_dist_busca


def filtro_limiar(d_ruido):
    """Aplica o filtro de limiar: descarta leituras muito curtas e satura
    as leituras muito longas no alcance maximo."""
    if d_ruido < LIMIAR_MIN:
        return None  # leitura descartada (erro)
    if d_ruido > ALCANCE_MAX:
        return ALCANCE_MAX
    return d_ruido


def main():
    pygame.init()
    tela = pygame.display.set_mode((LARGURA, ALTURA))
    pygame.display.set_caption("Lab 3 - Varredura Sensorial com Filtro")
    fonte = pygame.font.SysFont("consolas", 16)
    fonte_titulo = pygame.font.SysFont("consolas", 20, bold=True)
    clock = pygame.time.Clock()

    angulos = [(-FOV / 2) + i * (FOV / (N_FEIXES - 1)) for i in range(N_FEIXES)]

    rodando = True
    while rodando:
        for evento in pygame.event.get():
            if evento.type == pygame.QUIT:
                rodando = False
            if evento.type == pygame.KEYDOWN and evento.key == pygame.K_ESCAPE:
                rodando = False

        leituras_reais = []
        leituras_ruido = []
        leituras_filtradas = []
        for ang in angulos:
            d_real = distancia_real_do_feixe(ang)
            d_ruido = d_real + random.gauss(0, 5.0)
            d_ruido = max(0.0, d_ruido)
            d_filtrada = filtro_limiar(d_ruido)
            leituras_reais.append(d_real)
            leituras_ruido.append(d_ruido)
            leituras_filtradas.append(d_filtrada)

        tela.fill(BRANCO)

        titulo = fonte_titulo.render(
            "7 feixes, FOV 180 graus | Ruido gaussiano N(0, 5.0 px) | "
            "Filtro: <10px descarta, >200px crava em 200px", True, PRETO)
        tela.blit(titulo, (10, 10))

        # desenha obstaculos
        for (ox, oy, orad) in OBSTACULOS:
            pygame.draw.circle(tela, CINZA, (CENTRO[0] + ox, CENTRO[1] + oy), orad)

        # desenha feixes: bruto (laranja tracejado) e filtrado (verde solido)
        for ang, d_ruido, d_filt in zip(angulos, leituras_ruido, leituras_filtradas):
            d_bruta_desenho = min(d_ruido, 260.0)
            px = CENTRO[0] + d_bruta_desenho * math.sin(ang)
            py = CENTRO[1] - d_bruta_desenho * math.cos(ang)
            pygame.draw.line(tela, LARANJA, CENTRO, (px, py), 2)

            if d_filt is not None:
                fx = CENTRO[0] + d_filt * math.sin(ang)
                fy = CENTRO[1] - d_filt * math.cos(ang)
                pygame.draw.line(tela, VERDE, CENTRO, (fx, fy), 2)
                pygame.draw.circle(tela, VERDE, (int(fx), int(fy)), 5)
            else:
                # leitura descartada: marca com um X vermelho perto do robo
                ex = CENTRO[0] + 25 * math.sin(ang)
                ey = CENTRO[1] - 25 * math.cos(ang)
                pygame.draw.line(tela, VERMELHO, (ex - 6, ey - 6), (ex + 6, ey + 6), 2)
                pygame.draw.line(tela, VERMELHO, (ex - 6, ey + 6), (ex + 6, ey - 6), 2)

        pygame.draw.circle(tela, AZUL, CENTRO, 10)

        # painel lateral: bruto x filtrado, feixe a feixe
        painel_x = LARGURA - 300
        img = fonte_titulo.render("Bruto (ruido) x Filtrado", True, PRETO)
        tela.blit(img, (painel_x, 45))
        for i, (ang, d_ruido, d_filt) in enumerate(zip(angulos, leituras_ruido, leituras_filtradas)):
            filt_txt = f"{d_filt:6.1f} px" if d_filt is not None else "DESCARTADA"
            linha = (f"Feixe {i+1} ({math.degrees(ang):+5.1f} g): "
                     f"bruto={d_ruido:6.1f} px  ->  filtrado={filt_txt}")
            cor = PRETO if d_filt is not None else VERMELHO
            tela.blit(fonte.render(linha, True, cor), (painel_x, 75 + i * 22))

        legenda = [
            "Laranja = leitura bruta com ruido gaussiano",
            "Verde = leitura apos filtro de limiar",
            "X vermelho = leitura descartada (< 10 px)",
            "ESC para sair",
        ]
        for i, linha in enumerate(legenda):
            tela.blit(fonte.render(linha, True, PRETO), (10, ALTURA - 90 + i * 20))

        pygame.display.flip()
        clock.tick(FPS)

    pygame.quit()
    sys.exit()


if __name__ == "__main__":
    main()
