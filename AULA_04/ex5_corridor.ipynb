"""
Exercicio 5 - Centralizacao autonoma em corredor (Controle Proporcional)
---------------------------------------------------------------------------
O robo percorre um corredor retilineo formado por duas paredes paralelas.
Dois feixes laterais fixos (-90 e +90 graus em relacao ao eixo do robo)
medem as distancias ate a parede esquerda (d_esq) e a parede direita
(d_dir). O erro de centralizacao e = d_esq - d_dir alimenta uma lei de
controle proporcional w = Kp * e, com velocidade linear constante,
fazendo o robo se autocorrigir mesmo se iniciar desalinhado/descentrado.
"""

import math
import sys
import pygame

LARGURA, ALTURA = 950, 500
FPS = 60
DT = 1.0 / FPS

KP = 0.01
V_LINEAR = 40.0  # px/s, constante

PAREDE_TOPO_Y = 120
PAREDE_BASE_Y = 380
CENTRO_CORREDOR_Y = (PAREDE_TOPO_Y + PAREDE_BASE_Y) / 2.0
LARGURA_CORREDOR = PAREDE_BASE_Y - PAREDE_TOPO_Y

RAIO_ROBO = 12

BRANCO = (255, 255, 255)
PRETO = (20, 20, 20)
AZUL = (40, 110, 220)
VERMELHO = (220, 60, 60)
VERDE = (30, 160, 90)
CINZA = (150, 150, 150)


def mede_distancias_laterais(x, y, theta):
    """
    Feixes laterais fixos a -90 e +90 graus (relativos ao eixo do robo).
    Como o corredor e formado por paredes horizontais, a distancia ate
    cada parede e obtida projetando o feixe lateral ate a linha da
    parede correspondente.
    """
    ang_esq = theta + math.pi / 2.0   # +90 graus (lateral esquerda)
    ang_dir = theta - math.pi / 2.0   # -90 graus (lateral direita)

    def distancia_ate_parede(angulo):
        seno = math.sin(angulo)
        if abs(seno) < 1e-6:
            return LARGURA_CORREDOR  # feixe paralelo as paredes: sem leitura util
        if seno > 0:
            # aponta para cima da tela -> parede do topo
            dist = (y - PAREDE_TOPO_Y) / seno
        else:
            # aponta para baixo da tela -> parede da base
            dist = (y - PAREDE_BASE_Y) / seno
        return abs(dist)

    d_esq = distancia_ate_parede(ang_esq)
    d_dir = distancia_ate_parede(ang_dir)
    return d_esq, d_dir


def desenha_corredor(tela):
    pygame.draw.line(tela, PRETO, (0, PAREDE_TOPO_Y), (LARGURA, PAREDE_TOPO_Y), 4)
    pygame.draw.line(tela, PRETO, (0, PAREDE_BASE_Y), (LARGURA, PAREDE_BASE_Y), 4)
    pygame.draw.line(tela, CINZA, (0, int(CENTRO_CORREDOR_Y)),
                      (LARGURA, int(CENTRO_CORREDOR_Y)), 1)


def desenha_robo(tela, x, y, theta):
    pygame.draw.circle(tela, AZUL, (int(x), int(y)), RAIO_ROBO)
    ponta = (x + RAIO_ROBO * 1.8 * math.cos(theta), y - RAIO_ROBO * 1.8 * math.sin(theta))
    pygame.draw.line(tela, PRETO, (x, y), ponta, 3)


def main():
    pygame.init()
    tela = pygame.display.set_mode((LARGURA, ALTURA))
    pygame.display.set_caption("Lab 5 - Centralizacao em corredor (Controle P)")
    fonte = pygame.font.SysFont("consolas", 18)
    clock = pygame.time.Clock()

    # Robo inicia desalinhado (fora do centro) e com um pequeno erro de
    # orientacao, para demonstrar a auto-correcao do controlador P.
    x, y = 40.0, PAREDE_TOPO_Y + 40
    theta = math.radians(-8)
    trajeto = [(x, y)]

    rodando = True
    while rodando:
        for evento in pygame.event.get():
            if evento.type == pygame.QUIT:
                rodando = False
            if evento.type == pygame.KEYDOWN:
                if evento.key == pygame.K_ESCAPE:
                    rodando = False
                if evento.key == pygame.K_r:
                    x, y = 40.0, PAREDE_TOPO_Y + 40
                    theta = math.radians(-8)
                    trajeto = [(x, y)]

        d_esq, d_dir = mede_distancias_laterais(x, y, theta)
        erro = d_esq - d_dir
        w = KP * erro

        theta += w * DT
        x += V_LINEAR * math.cos(theta) * DT
        y -= V_LINEAR * math.sin(theta) * DT
        trajeto.append((x, y))
        if len(trajeto) > 1000:
            trajeto.pop(0)

        # Reinicia o robo no comeco do corredor ao alcancar o final,
        # preservando o desalinhamento inicial para nova demonstracao.
        if x > LARGURA - RAIO_ROBO:
            x = RAIO_ROBO + 5
            trajeto = [(x, y)]

        # Trava y dentro dos limites fisicos do corredor (colisao simples)
        y = max(PAREDE_TOPO_Y + RAIO_ROBO, min(PAREDE_BASE_Y - RAIO_ROBO, y))

        tela.fill(BRANCO)
        desenha_corredor(tela)

        if len(trajeto) > 1:
            pygame.draw.lines(tela, VERDE, False, trajeto, 2)

        desenha_robo(tela, x, y, theta)

        # desenha os feixes laterais (linhas ate as paredes)
        ang_esq = theta + math.pi / 2.0
        ang_dir = theta - math.pi / 2.0
        pe = (x + d_esq * math.cos(ang_esq), y - d_esq * math.sin(ang_esq))
        pd = (x + d_dir * math.cos(ang_dir), y - d_dir * math.sin(ang_dir))
        pygame.draw.line(tela, VERMELHO, (x, y), pe, 1)
        pygame.draw.line(tela, VERMELHO, (x, y), pd, 1)

        linhas_hud = [
            f"d_esq = {d_esq:6.1f} px   d_dir = {d_dir:6.1f} px",
            f"erro e = d_esq - d_dir = {erro:+7.2f}   Kp = {KP}",
            f"w = Kp * e = {w:+.4f} rad/s   |   v = {V_LINEAR:.1f} px/s (constante)",
            "O robo se autocorrige e converge para o centro do corredor.",
            "R = reiniciar (com o mesmo desalinhamento inicial) | ESC = sair",
        ]
        for i, linha in enumerate(linhas_hud):
            tela.blit(fonte.render(linha, True, PRETO), (10, 10 + i * 22))

        pygame.display.flip()
        clock.tick(FPS)

    pygame.quit()
    sys.exit()


if __name__ == "__main__":
    main()
