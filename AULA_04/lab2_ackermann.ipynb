"""
Exercicio 2 - Calculadora de giro Ackermann vs. Diferencial
--------------------------------------------------------------
Interface Pygame onde o usuario controla, via teclado, a velocidade
linear v e o angulo de esterco das rodas dianteiras phi de um veiculo
com tracao Ackermann (entre-eixos L = 2.0 m). Calcula w = (v/L)*tan(phi)
e o raio de curvatura R = L/tan(phi), limitando phi a +-30 graus e
demonstrando que R nunca chega a zero (diferente do robo diferencial,
que consegue R = 0 girando sobre o proprio eixo).
"""

import math
import sys
import pygame

LARGURA, ALTURA = 900, 650
FPS = 60
DT = 1.0 / FPS

L = 2.0  # entre-eixos (m)
PHI_MAX = math.radians(30)  # limite do angulo de esterco
V_MAX = 2.0  # m/s
V_STEP = 0.5 * DT     # incremento de velocidade por frame (tecla segurada)
PHI_STEP = math.radians(35) * DT  # incremento do angulo por frame

ESCALA_PX_POR_M = 25
ORIGEM = (LARGURA // 2, ALTURA // 2)

BRANCO = (255, 255, 255)
PRETO = (20, 20, 20)
AZUL = (40, 110, 220)
VERMELHO = (220, 60, 60)
VERDE = (30, 160, 90)
CINZA = (210, 210, 210)


def pose_para_pixel(x, y):
    px = ORIGEM[0] + x * ESCALA_PX_POR_M
    py = ORIGEM[1] - y * ESCALA_PX_POR_M
    return px, py


def desenha_grade(tela):
    for gx in range(0, LARGURA, ESCALA_PX_POR_M * 2):
        pygame.draw.line(tela, CINZA, (gx, 0), (gx, ALTURA), 1)
    for gy in range(0, ALTURA, ESCALA_PX_POR_M * 2):
        pygame.draw.line(tela, CINZA, (0, gy), (LARGURA, gy), 1)


def desenha_robo(tela, x, y, theta, cor):
    px, py = pose_para_pixel(x, y)
    raio = 10
    pygame.draw.circle(tela, cor, (int(px), int(py)), raio)
    ponta = (px + raio * 2.0 * math.cos(theta), py - raio * 2.0 * math.sin(theta))
    pygame.draw.line(tela, PRETO, (px, py), ponta, 3)


def main():
    pygame.init()
    tela = pygame.display.set_mode((LARGURA, ALTURA))
    pygame.display.set_caption("Lab 2 - Ackermann vs Diferencial")
    fonte = pygame.font.SysFont("consolas", 18)
    fonte_titulo = pygame.font.SysFont("consolas", 20, bold=True)
    clock = pygame.time.Clock()

    v = 0.0        # velocidade linear atual (m/s)
    phi = 0.0      # angulo de esterco atual (rad)

    # Pose do veiculo Ackermann
    x, y, theta = -6.0, -3.0, 0.0
    trajeto_ack = [(x, y)]

    # Pose do robo diferencial "de referencia" (mesma v, mas w livre = usa
    # a mesma w calculada apenas para efeito de comparacao numerica; o
    # ponto chave e que o diferencial PODE fazer phi=90 -> giro no proprio
    # eixo, coisa que o Ackermann jamais alcanca)
    x_dif, y_dif, theta_dif = 6.0, -3.0, 0.0
    trajeto_dif = [(x_dif, y_dif)]

    rodando = True
    while rodando:
        for evento in pygame.event.get():
            if evento.type == pygame.QUIT:
                rodando = False
            if evento.type == pygame.KEYDOWN:
                if evento.key == pygame.K_ESCAPE:
                    rodando = False
                if evento.key == pygame.K_r:
                    x, y, theta = -6.0, -3.0, 0.0
                    x_dif, y_dif, theta_dif = 6.0, -3.0, 0.0
                    trajeto_ack = [(x, y)]
                    trajeto_dif = [(x_dif, y_dif)]
                    v, phi = 0.0, 0.0

        teclas = pygame.key.get_pressed()
        if teclas[pygame.K_UP]:
            v = min(V_MAX, v + V_STEP)
        if teclas[pygame.K_DOWN]:
            v = max(-V_MAX, v - V_STEP)
        if teclas[pygame.K_LEFT]:
            phi = min(PHI_MAX, phi + PHI_STEP)
        if teclas[pygame.K_RIGHT]:
            phi = max(-PHI_MAX, phi - PHI_STEP)
        if teclas[pygame.K_SPACE]:
            v = 0.0

        # --- Modelo Ackermann (bicicleta) ---
        w_ack = (v / L) * math.tan(phi)
        if abs(math.tan(phi)) > 1e-6:
            raio_ack = L / math.tan(phi)
        else:
            raio_ack = math.inf

        theta += w_ack * DT
        x += v * math.cos(theta) * DT
        y += v * math.sin(theta) * DT
        trajeto_ack.append((x, y))

        # --- Modelo Diferencial de comparacao ---
        # O robo diferencial consegue produzir QUALQUER w independente de v,
        # inclusive girar com v=0 (R=0). Aqui usamos um w proporcional ao
        # mesmo "comando de direcao" phi, mas sem a limitacao geometrica do
        # Ackermann, apenas para contraste visual.
        w_dif = (v / L) * math.tan(phi) if abs(phi) < PHI_MAX else 0.0
        # Demonstra o caso extremo: girar no proprio eixo com v=0
        if teclas[pygame.K_g]:
            w_dif = math.radians(90)
            v_dif_efetivo = 0.0
        else:
            v_dif_efetivo = v
        theta_dif += w_dif * DT
        x_dif += v_dif_efetivo * math.cos(theta_dif) * DT
        y_dif += v_dif_efetivo * math.sin(theta_dif) * DT
        trajeto_dif.append((x_dif, y_dif))

        tela.fill(BRANCO)
        desenha_grade(tela)

        if len(trajeto_ack) > 1:
            pontos = [pose_para_pixel(px_, py_) for (px_, py_) in trajeto_ack[-600:]]
            pygame.draw.lines(tela, AZUL, False, pontos, 2)
        if len(trajeto_dif) > 1:
            pontos = [pose_para_pixel(px_, py_) for (px_, py_) in trajeto_dif[-600:]]
            pygame.draw.lines(tela, VERDE, False, pontos, 2)

        desenha_robo(tela, x, y, theta, AZUL)
        desenha_robo(tela, x_dif, y_dif, theta_dif, VERDE)

        raio_txt = "Infinito (reto)" if math.isinf(raio_ack) else f"{raio_ack:.2f} m"

        titulo = fonte_titulo.render(
            "Azul = Ackermann (bicicleta)   |   Verde = Diferencial (comparacao)",
            True, PRETO)
        tela.blit(titulo, (10, 10))

        linhas_hud = [
            f"v = {v:+.2f} m/s   |   phi (esterco) = {math.degrees(phi):+.1f} graus "
            f"(limite +-30)",
            f"w Ackermann = (v/L)*tan(phi) = {w_ack:+.4f} rad/s",
            f"R Ackermann = L/tan(phi) = {raio_txt}  -> nunca chega a 0!",
            f"Diferencial: consegue R = 0 girando no proprio eixo (tecle G)",
            "",
            "Setas: cima/baixo = velocidade | esquerda/direita = esterco",
            "G = giro no proprio eixo (so diferencial) | R = reiniciar | ESC = sair",
        ]
        for i, linha in enumerate(linhas_hud):
            cor = VERMELHO if "nunca chega" in linha else PRETO
            img = fonte.render(linha, True, cor)
            tela.blit(img, (10, 45 + i * 24))

        pygame.display.flip()
        clock.tick(FPS)

    pygame.quit()
    sys.exit()


if __name__ == "__main__":
    main()
