"""
Exercicio 4 - Braitenberg com conexoes diretas (Agressao/Atracao)
---------------------------------------------------------------------
Implementa conexoes NAO-CRUZADAS (diretas) de Braitenberg:
  sensor esquerdo -> roda esquerda
  sensor direito  -> roda direita
vL = v0 + alpha * (1 - d_esq/d_max)
vR = v0 + alpha * (1 - d_dir/d_max)

Ao aproximar-se de um obstaculo a direita, a roda direita acelera mais,
fazendo o robo VIRAR EM DIRECAO ao obstaculo (comportamento de
atracao/agressao) -- o oposto do comportamento de aversao/medo (conexao
cruzada) visto na aula anterior.
"""

import math
import sys
import pygame

LARGURA, ALTURA = 900, 650
FPS = 60
DT = 1.0 / FPS

V0 = 40.0          # velocidade base das rodas (px/s)
ALPHA = 140.0      # ganho de excitacao Braitenberg
D_MAX = 260.0      # distancia maxima de sensibilidade dos sensores (px)
RAIO_ROBO = 16
DIST_ENTRE_RODAS = 2 * RAIO_ROBO
V_MAX_RODA = 220.0

BRANCO = (255, 255, 255)
PRETO = (20, 20, 20)
AZUL = (40, 110, 220)
VERMELHO = (220, 60, 60)
CINZA = (140, 140, 140)
VERDE = (30, 160, 90)

OBSTACULO = {"x": 650, "y": 300, "raio": 40}


def sensores(x, y, theta, obstaculo):
    """
    Calcula a distancia do obstaculo ate os sensores esquerdo e direito
    do robo (posicionados a +-45 graus do eixo frontal). Retorna as
    distancias ja saturadas em [0, D_MAX].
    """
    ang_esq = theta + math.radians(45)
    ang_dir = theta - math.radians(45)

    sx_esq = x + RAIO_ROBO * math.cos(ang_esq)
    sy_esq = y - RAIO_ROBO * math.sin(ang_esq)
    sx_dir = x + RAIO_ROBO * math.cos(ang_dir)
    sy_dir = y - RAIO_ROBO * math.sin(ang_dir)

    d_esq = math.hypot(obstaculo["x"] - sx_esq, obstaculo["y"] - sy_esq) - obstaculo["raio"]
    d_dir = math.hypot(obstaculo["x"] - sx_dir, obstaculo["y"] - sy_dir) - obstaculo["raio"]

    d_esq = max(0.0, min(D_MAX, d_esq))
    d_dir = max(0.0, min(D_MAX, d_dir))
    return d_esq, d_dir, (sx_esq, sy_esq), (sx_dir, sy_dir)


def desenha_robo(tela, x, y, theta):
    pygame.draw.circle(tela, AZUL, (int(x), int(y)), RAIO_ROBO)
    ponta = (x + RAIO_ROBO * 1.6 * math.cos(theta), y - RAIO_ROBO * 1.6 * math.sin(theta))
    pygame.draw.line(tela, PRETO, (x, y), ponta, 3)


def main():
    pygame.init()
    tela = pygame.display.set_mode((LARGURA, ALTURA))
    pygame.display.set_caption("Lab 4 - Braitenberg (conexoes diretas)")
    fonte = pygame.font.SysFont("consolas", 18)
    clock = pygame.time.Clock()

    x, y, theta = 150.0, 350.0, math.radians(-10)
    trajeto = [(x, y)]

    rodando = True
    while rodando:
        for evento in pygame.event.get():
            if evento.type == pygame.QUIT:
                rodando = False
            if evento.type == pygame.KEYDOWN:
                if evento.key == pygame.K_ESCAPE:
                    rodando = False
                if evento.key == pygame.K_r:
                    x, y, theta = 150.0, 350.0, math.radians(-10)
                    trajeto = [(x, y)]

        # Reposiciona o obstaculo com o mouse (botao esquerdo)
        if pygame.mouse.get_pressed()[0]:
            mx, my = pygame.mouse.get_pos()
            OBSTACULO["x"], OBSTACULO["y"] = mx, my

        d_esq, d_dir, p_esq, p_dir = sensores(x, y, theta, OBSTACULO)

        # --- Conexoes DIRETAS (Braitenberg) ---
        vL = V0 + ALPHA * (1.0 - d_esq / D_MAX)
        vR = V0 + ALPHA * (1.0 - d_dir / D_MAX)
        vL = max(0.0, min(V_MAX_RODA, vL))
        vR = max(0.0, min(V_MAX_RODA, vR))

        # Cinematica diferencial a partir das velocidades das rodas
        v = (vL + vR) / 2.0
        w = (vR - vL) / DIST_ENTRE_RODAS

        theta += w * DT
        x += v * math.cos(theta) * DT
        y -= v * math.sin(theta) * DT
        trajeto.append((x, y))
        if len(trajeto) > 800:
            trajeto.pop(0)

        # Mantem o robo dentro da tela (colisao simples com bordas)
        x = max(RAIO_ROBO, min(LARGURA - RAIO_ROBO, x))
        y = max(RAIO_ROBO, min(ALTURA - RAIO_ROBO, y))

        tela.fill(BRANCO)

        if len(trajeto) > 1:
            pygame.draw.lines(tela, CINZA, False, trajeto, 2)

        pygame.draw.circle(tela, VERMELHO, (OBSTACULO["x"], OBSTACULO["y"]), OBSTACULO["raio"])

        desenha_robo(tela, x, y, theta)
        pygame.draw.circle(tela, VERDE, (int(p_esq[0]), int(p_esq[1])), 4)
        pygame.draw.circle(tela, VERDE, (int(p_dir[0]), int(p_dir[1])), 4)

        linhas_hud = [
            "Conexao DIRETA: sensor esquerdo -> roda esquerda | "
            "sensor direito -> roda direita",
            f"d_esq = {d_esq:6.1f} px   d_dir = {d_dir:6.1f} px",
            f"vL = v0 + alpha*(1-d_esq/dmax) = {vL:6.1f} px/s",
            f"vR = v0 + alpha*(1-d_dir/dmax) = {vR:6.1f} px/s",
            "Obstaculo a direita => roda direita acelera => o robo VIRA",
            "PARA o obstaculo (atracao/agressao), oposto ao medo da Aula 03.",
            "Arraste o obstaculo com o botao esquerdo do mouse.",
            "R = reiniciar | ESC = sair",
        ]
        for i, linha in enumerate(linhas_hud):
            cor = VERMELHO if "atracao" in linha else PRETO
            tela.blit(fonte.render(linha, True, cor), (10, 10 + i * 22))

        pygame.display.flip()
        clock.tick(FPS)

    pygame.quit()
    sys.exit()


if __name__ == "__main__":
    main()
