"""
Exercicio 1 - Validador de Pose em malha aberta (Cinematica Diferencial)
-------------------------------------------------------------------------
Aplica em malha aberta uma sequencia de comandos de velocidade (v, w)
temporizados sobre um robo diferencial, calcula a Pose final teorica
(via integracao analitica do modelo unicycle) e simula o movimento
no Pygame passo a passo (integracao numerica / Euler), comparando os
dois resultados ao final.
"""

import math
import sys
import pygame

# ---------------------------------------------------------------------------
# Configuracoes gerais
# ---------------------------------------------------------------------------
LARGURA, ALTURA = 900, 600
FPS = 60
DT = 1.0 / FPS

# Origem da tela (0,0 do robo) fica a esquerda, com escala em pixels/metro
ESCALA_PX_POR_M = 60
ORIGEM = (150, ALTURA // 2)

BRANCO = (255, 255, 255)
PRETO = (20, 20, 20)
AZUL = (40, 110, 220)
VERMELHO = (220, 60, 60)
CINZA = (200, 200, 200)

# Sequencia de comandos: (duracao_s, v_m_s, w_rad_s)
SEQUENCIA = [
    (4.0, 0.5, 0.0),
    (2.0, 0.0, math.pi / 4.0),
    (3.0, 0.4, 0.0),
]


def pose_para_pixel(x, y):
    """Converte coordenadas (x, y) em metros para pixels na tela."""
    px = ORIGEM[0] + x * ESCALA_PX_POR_M
    py = ORIGEM[1] - y * ESCALA_PX_POR_M
    return px, py


def integra_pose_analitica(x, y, theta, v, w, t):
    """
    Integra analiticamente a pose do modelo unicycle para um trecho de
    velocidade constante (v, w) durante um tempo t.
    """
    if abs(w) < 1e-9:
        x_novo = x + v * t * math.cos(theta)
        y_novo = y + v * t * math.sin(theta)
        theta_novo = theta
    else:
        theta_novo = theta + w * t
        x_novo = x + (v / w) * (math.sin(theta_novo) - math.sin(theta))
        y_novo = y - (v / w) * (math.cos(theta_novo) - math.cos(theta))
    return x_novo, y_novo, theta_novo


def calcula_pose_teorica_final(sequencia):
    """Calcula a pose final teorica aplicando todos os trechos em sequencia."""
    x, y, theta = 0.0, 0.0, 0.0
    for t, v, w in sequencia:
        x, y, theta = integra_pose_analitica(x, y, theta, v, w, t)
    return x, y, theta


def desenha_robo(tela, x, y, theta, cor):
    px, py = pose_para_pixel(x, y)
    raio = 12
    pygame.draw.circle(tela, cor, (int(px), int(py)), raio)
    ponta = (px + raio * 1.8 * math.cos(theta), py - raio * 1.8 * math.sin(theta))
    pygame.draw.line(tela, PRETO, (px, py), ponta, 3)


def desenha_grade(tela):
    for gx in range(0, LARGURA, ESCALA_PX_POR_M):
        pygame.draw.line(tela, CINZA, (gx, 0), (gx, ALTURA), 1)
    for gy in range(0, ALTURA, ESCALA_PX_POR_M):
        pygame.draw.line(tela, CINZA, (0, gy), (LARGURA, gy), 1)
    pygame.draw.line(tela, PRETO, (0, ORIGEM[1]), (LARGURA, ORIGEM[1]), 2)
    pygame.draw.line(tela, PRETO, (ORIGEM[0], 0), (ORIGEM[0], ALTURA), 2)


def main():
    pygame.init()
    tela = pygame.display.set_mode((LARGURA, ALTURA))
    pygame.display.set_caption("Lab 1 - Validador de Pose (malha aberta)")
    fonte = pygame.font.SysFont("consolas", 18)
    clock = pygame.time.Clock()

    # Pose teorica (calculada analiticamente, de uma vez, no inicio)
    x_teo, y_teo, theta_teo = calcula_pose_teorica_final(SEQUENCIA)

    # Estado da simulacao (integrado passo a passo, Euler, dentro do loop)
    x_sim, y_sim, theta_sim = 0.0, 0.0, 0.0
    trajeto = [(x_sim, y_sim)]

    indice_trecho = 0
    tempo_no_trecho = 0.0
    simulacao_concluida = False
    resultado_impresso = False

    rodando = True
    while rodando:
        for evento in pygame.event.get():
            if evento.type == pygame.QUIT:
                rodando = False
            if evento.type == pygame.KEYDOWN and evento.key == pygame.K_ESCAPE:
                rodando = False

        if not simulacao_concluida:
            t_trecho, v, w = SEQUENCIA[indice_trecho]
            # Integracao numerica (Euler) da pose simulada
            theta_sim += w * DT
            x_sim += v * math.cos(theta_sim) * DT
            y_sim += v * math.sin(theta_sim) * DT
            trajeto.append((x_sim, y_sim))

            tempo_no_trecho += DT
            if tempo_no_trecho >= t_trecho:
                indice_trecho += 1
                tempo_no_trecho = 0.0
                if indice_trecho >= len(SEQUENCIA):
                    simulacao_concluida = True

        if simulacao_concluida and not resultado_impresso:
            print("=" * 60)
            print("Pose FINAL TEORICA  (integracao analitica):")
            print(f"  x = {x_teo:.4f} m | y = {y_teo:.4f} m | "
                  f"theta = {math.degrees(theta_teo):.2f} graus")
            print("Pose FINAL SIMULADA (integracao numerica no Pygame):")
            print(f"  x = {x_sim:.4f} m | y = {y_sim:.4f} m | "
                  f"theta = {math.degrees(theta_sim):.2f} graus")
            erro = math.hypot(x_teo - x_sim, y_teo - y_sim)
            print(f"Erro de posicao (teorico vs simulado): {erro:.5f} m")
            print("=" * 60)
            resultado_impresso = True

        tela.fill(BRANCO)
        desenha_grade(tela)

        if len(trajeto) > 1:
            pontos_px = [pose_para_pixel(px, py) for (px, py) in trajeto]
            pygame.draw.lines(tela, AZUL, False, pontos_px, 2)

        desenha_robo(tela, x_sim, y_sim, theta_sim, AZUL)

        if simulacao_concluida:
            desenha_robo(tela, x_teo, y_teo, theta_teo, VERMELHO)

        linhas_hud = [
            "Sequencia: (v=0.5,w=0 por 4s) -> (v=0,w=pi/4 por 2s) -> (v=0.4,w=0 por 3s)",
            f"Simulado : x={x_sim:.3f} y={y_sim:.3f} theta={math.degrees(theta_sim):.1f} graus",
            f"Teorico  : x={x_teo:.3f} y={y_teo:.3f} theta={math.degrees(theta_teo):.1f} graus",
            "Azul = robo simulado (rastro azul) | Vermelho = pose teorica final",
            "ESC para sair",
        ]
        for i, linha in enumerate(linhas_hud):
            img = fonte.render(linha, True, PRETO)
            tela.blit(img, (10, 10 + i * 22))

        pygame.display.flip()
        clock.tick(FPS)

    pygame.quit()
    sys.exit()


if __name__ == "__main__":
    main()
