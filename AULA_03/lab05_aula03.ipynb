import pygame
import math

LARGURA, ALTURA = 900, 650
FPS = 60
COR_FUNDO = (20, 24, 30)
COR_ROBO = (0, 200, 255)
COR_OBSTACULO = (180, 50, 50)
COR_ALVO = (50, 220, 100)
COR_RAIO_LIVRE = (0, 255, 100)
COR_RAIO_COLISAO = (255, 200, 0)

EIXO_RODAS = 20.0
V_CRUZEIRO = 70.0
DIST_EMERGENCIA = 45.0     
K_REPULSIVO = 2.2         
K_ATRACAO = 3.0            
DIST_PARADA = 15.0         


class GoToGoalRobot:
    def __init__(self, x, y, theta=0.0):
        self.x = float(x)
        self.y = float(y)
        self.theta = float(theta)
        self.sensor_angles = [-math.pi / 3, 0.0, math.pi / 3]  
        self.sensor_range = 130.0
        self.sensor_readings = [self.sensor_range] * 3

    def cast_rays(self, obstacles):
        self.sensor_readings = []
        for beta in self.sensor_angles:
            angle = self.theta + beta
            min_dist = self.sensor_range
            for step in range(5, int(self.sensor_range), 4):
                rx = self.x + step * math.cos(angle)
                ry = self.y + step * math.sin(angle)
                if rx <= 0 or rx >= LARGURA or ry <= 0 or ry >= ALTURA:
                    min_dist = float(step)
                    break
                hit = False
                for obs in obstacles:
                    if obs.collidepoint(rx, ry):
                        min_dist = float(step)
                        hit = True
                        break
                if hit:
                    break
            self.sensor_readings.append(min_dist)

    def calcular_rodas(self, goal):
        d_esq, d_frente, d_dir = self.sensor_readings
        obstaculo_perto = min(self.sensor_readings) < DIST_EMERGENCIA

        dist_alvo = None
        erro_ang = 0.0
        if goal is not None:
            gx, gy = goal
            dist_alvo = math.hypot(gx - self.x, gy - self.y)
            if dist_alvo < DIST_PARADA:
                return 0.0, 0.0, dist_alvo
            angulo_alvo = math.atan2(gy - self.y, gx - self.x)
            erro_ang = math.atan2(
                math.sin(angulo_alvo - self.theta), math.cos(angulo_alvo - self.theta)
            )

        v_base = V_CRUZEIRO

        if obstaculo_perto:
            prox_esq = max(0.0, (self.sensor_range - d_esq) / self.sensor_range)
            prox_dir = max(0.0, (self.sensor_range - d_dir) / self.sensor_range)
            omega = K_REPULSIVO * (prox_esq - prox_dir)
            v_base *= 0.5
        else:
            omega = K_ATRACAO * erro_ang

        vL = v_base - omega * (EIXO_RODAS / 2.0)
        vR = v_base + omega * (EIXO_RODAS / 2.0)
        return vL, vR, dist_alvo

    def mover(self, vL, vR, dt):
        v = (vR + vL) / 2.0
        omega = (vR - vL) / EIXO_RODAS
        self.x += v * math.cos(self.theta) * dt
        self.y += v * math.sin(self.theta) * dt
        self.theta += omega * dt
        self.x = max(10, min(LARGURA - 10, self.x))
        self.y = max(10, min(ALTURA - 10, self.y))

    def draw(self, surface):
        for i, beta in enumerate(self.sensor_angles):
            angle = self.theta + beta
            dist = self.sensor_readings[i]
            rx = self.x + dist * math.cos(angle)
            ry = self.y + dist * math.sin(angle)
            cor = COR_RAIO_COLISAO if dist < self.sensor_range else COR_RAIO_LIVRE
            pygame.draw.line(surface, cor, (int(self.x), int(self.y)), (int(rx), int(ry)), 2)
        pos = (int(self.x), int(self.y))
        pygame.draw.circle(surface, COR_ROBO, pos, 14)
        fx = self.x + 22 * math.cos(self.theta)
        fy = self.y + 22 * math.sin(self.theta)
        pygame.draw.line(surface, (255, 50, 50), pos, (int(fx), int(fy)), 3)


def main():
    pygame.init()
    screen = pygame.display.set_mode((LARGURA, ALTURA))
    pygame.display.set_caption("LAB 5 - Go-to-Goal com Desvio Reativo")
    clock = pygame.time.Clock()
    font = pygame.font.SysFont("monospace", 14)

    robot = GoToGoalRobot(100, 100, theta=0.0)
    obstacles = [
        pygame.Rect(350, 150, 60, 350),
        pygame.Rect(600, 100, 150, 60),
        pygame.Rect(600, 400, 150, 150),
    ]
    goal = None

    running = True
    while running:
        dt = clock.tick(FPS) / 1000.0
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            elif event.type == pygame.MOUSEBUTTONDOWN:
                goal = event.pos

        robot.cast_rays(obstacles)
        vL, vR, dist_alvo = robot.calcular_rodas(goal)
        robot.mover(vL, vR, dt)

        screen.fill(COR_FUNDO)
        for obs in obstacles:
            pygame.draw.rect(screen, COR_OBSTACULO, obs)
        if goal is not None:
            pygame.draw.circle(screen, COR_ALVO, goal, 8)
            pygame.draw.circle(screen, COR_ALVO, goal, int(DIST_PARADA), 1)
        robot.draw(screen)

        info = [
            "Clique com o mouse para definir o alvo.",
            f"vL: {vL:6.1f}  vR: {vR:6.1f}",
            f"Dist. ao alvo: {dist_alvo:6.1f} px" if dist_alvo is not None else "Dist. ao alvo: --",
        ]
        for i, l in enumerate(info):
            screen.blit(font.render(l, True, (220, 220, 220)), (20, 20 + i * 18))

        pygame.display.flip()
    pygame.quit()


if __name__ == "__main__":
    main()
