import pygame
import math

LARGURA, ALTURA = 900, 650
FPS = 60
COR_FUNDO = (20, 24, 30)
COR_ROBO = (0, 200, 255)
ANGULO_ALVO_GRAUS = 180.0   
OMEGA = 0.8                  


class RobotRotacao:
    def __init__(self, x, y, theta=0.0):
        self.x = float(x)
        self.y = float(y)
        self.theta = float(theta)

    def girar(self, omega, dt):
        self.theta += omega * dt

    def draw(self, surface):
        pos = (int(self.x), int(self.y))
        pygame.draw.circle(surface, COR_ROBO, pos, 20)
        fx = self.x + 30 * math.cos(self.theta)
        fy = self.y + 30 * math.sin(self.theta)
        pygame.draw.line(surface, (255, 50, 50), pos, (int(fx), int(fy)), 4)


def main():
    pygame.init()
    screen = pygame.display.set_mode((LARGURA, ALTURA))
    pygame.display.set_caption("LAB 2 - Rotacao In-Place (180 graus)")
    clock = pygame.time.Clock()
    font = pygame.font.SysFont("monospace", 16)

    robot = RobotRotacao(LARGURA // 2, ALTURA // 2, theta=0.0)

    angulo_alvo_rad = math.radians(ANGULO_ALVO_GRAUS)
    tempo_total_estimado = angulo_alvo_rad / OMEGA

    print("=== LAB 2 - Rotacao In-Place ===")
    print(f"[cmd_vel] Angulo alvo: {ANGULO_ALVO_GRAUS} graus ({angulo_alvo_rad:.3f} rad)")
    print(f"[cmd_vel] Velocidade angular publicada: omega = {OMEGA:.3f} rad/s")
    print(f"[cmd_vel] Tempo estimado de giro: t = theta/omega = {tempo_total_estimado:.3f} s")

    theta_inicial = robot.theta
    girando = True
    tempo_decorrido = 0.0
    zeramento_enviado = False

    running = True
    while running:
        dt = clock.tick(FPS) / 1000.0
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

        if girando:
            angulo_percorrido = robot.theta - theta_inicial
            angulo_restante = angulo_alvo_rad - angulo_percorrido
            if angulo_restante > 1e-3:
                robot.girar(OMEGA, dt)
                tempo_decorrido += dt
            else:
                girando = False
        elif not zeramento_enviado:
            print(f"[cmd_vel] Zeramento de velocidade enviado (omega = 0.0)")
            print(f"[cmd_vel] Tempo real de giro: {tempo_decorrido:.3f} s")
            print(f"[cmd_vel] Orientacao final: {math.degrees(robot.theta - theta_inicial):.2f} graus")
            print(f"[posicao] x = {robot.x:.1f}  y = {robot.y:.1f} (mantida fixa)")
            zeramento_enviado = True

        screen.fill(COR_FUNDO)
        robot.draw(screen)

        status = "GIRANDO" if girando else "PARADO (cmd_vel = 0)"
        info = [
            f"Status: {status}",
            f"Theta atual: {math.degrees(robot.theta - theta_inicial):6.2f} graus / {ANGULO_ALVO_GRAUS} graus",
            f"Omega: {OMEGA:.3f} rad/s",
            f"Tempo estimado total: {tempo_total_estimado:.3f} s",
            f"Tempo decorrido: {tempo_decorrido:.3f} s",
            f"Posicao (x, y): ({robot.x:.1f}, {robot.y:.1f})  -- fixa",
        ]
        for i, l in enumerate(info):
            screen.blit(font.render(l, True, (220, 220, 220)), (20, 20 + i * 22))

        pygame.display.flip()
    pygame.quit()


if __name__ == "__main__":
    main()
