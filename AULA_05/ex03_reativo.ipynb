"""Exercício 3 - Lógica reativa de obstáculos (Braitenberg + trava de segurança)."""

D_CRITICA = 0.4     # m
V_AVANCO = 0.5      # m/s
OMEGA_GIRO = 1.0    # rad/s
K_LATERAL = 0.5     # ganho sobre (esq - dir)
OMEGA_MAX = 1.0     # rad/s


def controle_reativo(distancias, d_critica=D_CRITICA):
    """distancias = {'frente','esquerda','direita'} -> (v, omega).
    omega > 0 gira à esquerda (anti-horário)."""
    frente = distancias["frente"]
    esq = distancias["esquerda"]
    dir_ = distancias["direita"]

    # Trava de segurança: freia e gira para o lado mais livre
    if frente < d_critica:
        omega = OMEGA_GIRO if esq >= dir_ else -OMEGA_GIRO
        return 0.0, omega

    # Frente livre: avança e corrige omega proporcional à diferença lateral
    # (mais espaço à esquerda -> omega positivo -> vira à esquerda)
    omega = K_LATERAL * (esq - dir_)
    omega = max(-OMEGA_MAX, min(OMEGA_MAX, omega))
    return V_AVANCO, omega


if __name__ == "__main__":
    casos = {
        "Frente bloqueada, esquerda livre": {"frente": 0.3, "esquerda": 2.0, "direita": 0.8},
        "Frente bloqueada, direita livre":  {"frente": 0.3, "esquerda": 0.6, "direita": 3.0},
        "Frente livre, mais espaço à esq.": {"frente": 3.0, "esquerda": 2.0, "direita": 1.5},
        "Frente livre, mais espaço à dir.": {"frente": 3.0, "esquerda": 1.0, "direita": 2.5},
        "Frente livre, corredor simétrico": {"frente": 3.0, "esquerda": 1.5, "direita": 1.5},
    }
    for nome, d in casos.items():
        print(f"{nome:36s} -> (v, omega) = {controle_reativo(d)}")
