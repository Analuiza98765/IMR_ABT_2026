"""Exercício 4 - Controlador proporcional de orientação para atração ao alvo."""
import math


def normalizar_angulo(a):
    """Normaliza para [-pi, pi]."""
    return math.atan2(math.sin(a), math.cos(a))


def calcular_orientacao_alvo(x, y, theta, x_alvo, y_alvo, Kp=1.5):
    # 1. Ângulo desejado
    theta_alvo = math.atan2(y_alvo - y, x_alvo - x)
    # 2. Erro de orientação normalizado (caminho angular mais curto)
    e_theta = normalizar_angulo(theta_alvo - theta)
    # 3. Lei proporcional: omega = Kp * e_theta
    #    (o enunciado escreve "K_p * theta", mas a lei correta usa o erro e_theta)
    return Kp * e_theta


if __name__ == "__main__":
    print(calcular_orientacao_alvo(0, 0, 0, 1, 1))                   # alvo a 45°
    print(calcular_orientacao_alvo(0, 0, math.radians(170), -1, -1)) # cruza ±pi
    print(calcular_orientacao_alvo(0, 0, math.radians(-170), -1, 0.1))
