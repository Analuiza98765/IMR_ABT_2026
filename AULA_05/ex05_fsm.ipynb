"""Exercício 5 - Máquina de Estados Finitos do robô autônomo."""
import math
from ex03_reativo import controle_reativo
from ex04_alvo import calcular_orientacao_alvo, normalizar_angulo

IR_PARA_ALVO = "IR_PARA_ALVO"
DESVIAR_OBSTACULO = "DESVIAR_OBSTACULO"
OBJETIVO_ALCANCADO = "OBJETIVO_ALCANÇADO"

D_OBSTACULO = 0.5   # m  (frente < 0.5 -> desviar)
D_OBJETIVO = 0.2    # m  (dist. ao alvo < 0.2 -> chegou)
V_CRUZEIRO = 0.5    # m/s


def maquina_de_estados(x, y, theta, x_alvo, y_alvo, dist_frente, dist_esq, dist_dir):
    dist_alvo = math.sqrt((x_alvo - x) ** 2 + (y_alvo - y) ** 2)

    # Prioridade 1: objetivo alcançado
    if dist_alvo < D_OBJETIVO:
        return OBJETIVO_ALCANCADO, 0.0, 0.0

    # Prioridade 2: obstáculo à frente -> lógica do Exercício 3
    # (a distância crítica do controle reativo é elevada a 0.5 m para
    #  ficar coerente com o gatilho do estado DESVIAR_OBSTACULO)
    if dist_frente < D_OBSTACULO:
        distancias = {"frente": dist_frente, "esquerda": dist_esq, "direita": dist_dir}
        v, omega = controle_reativo(distancias, d_critica=D_OBSTACULO)
        return DESVIAR_OBSTACULO, v, omega

    # Caso contrário: ir ao alvo -> lógica do Exercício 4
    omega = calcular_orientacao_alvo(x, y, theta, x_alvo, y_alvo)
    theta_alvo = math.atan2(y_alvo - y, x_alvo - x)
    e_theta = normalizar_angulo(theta_alvo - theta)
    # reduz a velocidade linear quando desalinhado (0 se erro > 90°)
    v = V_CRUZEIRO * max(0.0, math.cos(e_theta))
    return IR_PARA_ALVO, v, omega


if __name__ == "__main__":
    print(maquina_de_estados(0, 0, 0, 5, 0, 3.0, 2.0, 2.0))
    print(maquina_de_estados(0, 0, 0, 5, 0, 0.3, 2.0, 1.0))
    print(maquina_de_estados(4.9, 0, 0, 5, 0, 3.0, 2.0, 2.0))
