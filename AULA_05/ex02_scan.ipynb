"""Exercício 2 - Processador/filtro do tópico /scan (LiDAR 360 leituras)."""
import numpy as np

R_MIN, R_MAX = 0.1, 5.0

# Índice = ângulo em graus (0° = frente, +90° = esquerda, CCW)
SETORES = {
    "frente": list(range(345, 360)) + list(range(0, 16)),  # 345° a 15°
    "esquerda": list(range(45, 136)),                      # 45° a 135°
    "direita": list(range(225, 316)),                      # 225° a 315°
}


def processar_scan(leituras_lidar):
    """Retorna {'frente','esquerda','direita'} com a menor distância válida
    de cada setor. Se um setor não tiver nenhuma leitura válida, retorna R_MAX
    (sem obstáculo detectável = livre)."""
    leituras = np.asarray(leituras_lidar, dtype=float)
    if leituras.shape[0] != 360:
        raise ValueError("Esperadas 360 leituras (1 por grau).")

    resultado = {}
    for nome, idx in SETORES.items():
        setor = leituras[idx]
        # descarta NaN, inf, nulos (0.0), < 0.1 m e > 5.0 m
        validas = setor[np.isfinite(setor) & (setor >= R_MIN) & (setor <= R_MAX)]
        resultado[nome] = float(validas.min()) if validas.size else R_MAX
    return resultado


if __name__ == "__main__":
    rng = np.random.default_rng(42)
    scan = rng.uniform(0.5, 4.5, 360)
    scan[[0, 10, 50, 100, 230]] = 0.0        # ruído nulo
    scan[[5, 60, 250, 300]] = np.inf         # fora de alcance
    scan[[355, 90]] = 0.05                   # abaixo do mínimo
    print(processar_scan(scan))
